# Claude Task Runner — Environment Variables
# Copy to .env and fill in your values

# Your domain name (must point to your server's IP)
DOMAIN=tasks.yourdomain.com

# Public URL of this server (used for MCP auth metadata)
SERVER_URL=https://tasks.yourdomain.com

# Max concurrent tasks (default: 2)
MAX_CONCURRENT=2

# Default task timeout in minutes (default: 60)
DEFAULT_TIMEOUT_MINUTES=60

# Deployment type: 'local', 'self-hosted', or 'hosted' (auto-detected if omitted).
# Surfaced via the server_info MCP tool and the connection instructions block.
# DEPLOYMENT=self-hosted

# Optional: Anthropic API key (only if NOT using Claude Pro/Max subscription)
# If using Pro/Max, run `claude setup-token` instead — no key needed here.
# ANTHROPIC_API_KEY=sk-ant-...
